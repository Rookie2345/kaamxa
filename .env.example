# Supabase (Get these from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Secret Service Role Key (NEVER use in client-side code, only for server / admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for Auth Redirects (http://localhost:3000 for local dev, or your https://*.onrender.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
